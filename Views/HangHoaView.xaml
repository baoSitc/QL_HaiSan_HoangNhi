<UserControl x:Class="QL_HaiSan_HoangNhi.Views.HangHoaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:QL_HaiSan_HoangNhi.Views"
             xmlns:vm="clr-namespace:QL_HaiSan_HoangNhi.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800" >
   


    <UserControl.DataContext>
        <vm:HangHoaViewModel/>
    </UserControl.DataContext>
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <TextBlock Text="Tìm kiếm:"
                       VerticalAlignment="Center"
                       Margin="5"/>
            
            <TextBox Width="250"
         Height="35"
         Margin="5"
         Text="{Binding TuKhoa,
                UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>



        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <TextBlock Text="Loại hàng:"
                       VerticalAlignment="Center"
                       Margin="5"/>
            <ComboBox Width="200"
          Margin="5"
          ItemsSource="{Binding DanhSachLoaiHang}"
          DisplayMemberPath="Tenloai"
          SelectedValuePath="Id"
          SelectedValue="{Binding SelectedHangHoa.LoaihangId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="+"
        Width="40"
        Height="30"
        Margin="5"
        Command="{Binding MoFormLoaiHangCommand}"/>
           <TextBlock Text="Tên hàng:"
                       VerticalAlignment="Center"
                       Margin="5"
                      />

            <TextBox Width="200"
                     Margin="5"
                     Text="{Binding SelectedHangHoa.Tenhh,Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>
            
            <TextBlock Text="Đơn vị tính:"
                       VerticalAlignment="Center"
                       Margin="5"/>
            <ComboBox Width="150"
          Margin="5"
          ItemsSource="{Binding DanhSachDVT}"
          SelectedItem="{Binding SelectedHangHoa.Dvt,
                         Mode=TwoWay,
                         UpdateSourceTrigger=PropertyChanged}"/>


            <TextBlock Text="Giá nhập:"
             VerticalAlignment="Center"
             Margin="5"/>

            <TextBox Width="100"
           Margin="5"
           Text="{Binding SelectedHangHoa.Gianhap,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:N0}   }"/>
            <TextBlock Text="Giá bán:"
                       VerticalAlignment="Center"
                       Margin="5"/>

            <TextBox Width="100"
                     Margin="5"
                     Text="{Binding SelectedHangHoa.Giaban,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:N0}}"/>

            <Button Content="Thêm"
                    Width="100"
                    Margin="5"
                     Background="#4CAF50"
        Foreground="White"
        Style="{StaticResource MaterialDesignRaisedButton}"

                    Command="{Binding ThemCommand}"/>
            
           
            <Button Content="Sửa"
         Width="100"
         Margin="5"
         Command="{Binding SuaCommand}"/>

        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding DanhSachHangHoa}"
                  SelectedItem="{Binding SelectedHangHoa}"
                  AutoGenerateColumns="False"
                  Margin="5">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"/>
                
                <DataGridTextColumn Header="Tên hàng"
                     Binding="{Binding Tenhh}"/>
                
                <DataGridTextColumn Header="Đơn vị tính"
                                    Binding="{Binding Dvt}"/>                
                
                <DataGridTextColumn Header="Giá Nhập"
                     Binding="{Binding Gianhap,StringFormat={}{0:N0}}"/>

                <DataGridTextColumn Header="Giá bán"
                                    Binding="{Binding Giaban,StringFormat={}{0:N0}}"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</UserControl>
