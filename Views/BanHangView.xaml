<UserControl x:Class="QL_HaiSan_HoangNhi.Views.BanHangView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:QL_HaiSan_HoangNhi.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1400">

    <UserControl.DataContext>

        <vm:BanHangViewModel/>

    </UserControl.DataContext>

    <Grid Background="#F5F5F5"
          Margin="10">

        <Grid.ColumnDefinitions>

            <!-- LEFT -->
            <ColumnDefinition Width="1.4*"/>

            <!-- RIGHT -->
            <ColumnDefinition Width="1*"/>

        </Grid.ColumnDefinitions>

        <!-- ================================================= -->
        <!-- LEFT : HÀNG HÓA -->
        <!-- ================================================= -->

        <Grid Grid.Column="0"
              Margin="0,0,10,0">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <!-- FILTER -->
            <GroupBox Header="HÀNG HÓA"
                      FontSize="14"
                      FontWeight="Bold"
                      Margin="0,0,0,10">

                <Border Background="White"
                        Padding="10">

                    <StackPanel Orientation="Horizontal">

                        <!-- LOẠI HÀNG -->
                        <ComboBox Width="220"
                                  Height="35"
                                  Margin="5"
                                  ItemsSource="{Binding DanhSachLoaiHang}"
                                  SelectedItem="{Binding SelectedLoaiHang}"
                                  DisplayMemberPath="Tenloai"/>

                        <!-- SEARCH -->
                        <TextBox Width="300"
                                 Height="35"
                                 Margin="5"
                                 Text="{Binding TuKhoa,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Tìm hàng hóa..."/>

                    </StackPanel>

                </Border>

            </GroupBox>

            <!-- DANH SÁCH HÀNG -->
            <GroupBox Grid.Row="1"
                      Header="DANH SÁCH HÀNG"
                      FontWeight="Bold"
                      FontSize="14">

                <Border Background="White"
                        Padding="10">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <ItemsControl ItemsSource="{Binding DanhSachHangHoa}">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <WrapPanel/>

                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Button Width="170"
                                            Height="130"
                                            Margin="6"
                                            Padding="5"
                                            Background="White"
                                            BorderBrush="#DDDDDD"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.ChonHangCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">

                                        <StackPanel>

                                            <!-- IMAGE -->
                                            <Border Height="55"
                                                    Background="#EEEEEE"
                                                    CornerRadius="5"
                                                    Margin="0,0,0,5">

                                                <TextBlock Text="Hình"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="Gray"/>

                                            </Border>

                                            <!-- TÊN -->
                                            <TextBlock Text="{Binding Tenhh}"
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       MaxHeight="40"/>

                                            <!-- GIÁ -->
                                            <TextBlock Text="{Binding Giaban,
                                                                      StringFormat={}{0:N0} đ}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#E53935"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"/>

                                        </StackPanel>

                                    </Button>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Border>

            </GroupBox>

        </Grid>

        <!-- ================================================= -->
        <!-- RIGHT : GIỎ HÀNG -->
        <!-- ================================================= -->

        <Grid Grid.Column="1">
          

            <TabControl ItemsSource="{Binding DanhSachHoaDonTam}"
                SelectedItem="{Binding SelectedHoaDon}">

                <!-- HEADER -->
                <TabControl.ItemTemplate>

                    <DataTemplate>

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Receipt"
                                             Width="16"
                                             Height="16"
                                             Margin="0,0,5,0"/>

                            <TextBlock Text="{Binding TenTab}"/>

                        </StackPanel>

                    </DataTemplate>

                </TabControl.ItemTemplate>

                <!-- CONTENT -->
                <TabControl.ContentTemplate>

                    <DataTemplate>

                        <DockPanel Margin="5">

                            <!-- THANH TOÁN -->
                            <GroupBox Header="THANH TOÁN"
                      DockPanel.Dock="Bottom"
                      FontWeight="Bold"
                      Margin="0,10,0,0">

                                <Border Background="White"
                        Padding="10">

                                    <StackPanel>

                                        <!-- TỔNG TIỀN -->
                                        <TextBlock Text="{Binding TongTien,
                                                  StringFormat=Tổng tiền: {0:N0} đ}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#E53935"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,0,10"/>

                                        <!-- BUTTON -->
                                        <UniformGrid Columns="2">

                                            <!-- LƯU TẠM -->
                                            <Button Content="Tạo mới"
                                    Height="45"
                                    Margin="5"
                                    Background="#FF9800"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Command="{Binding DataContext.TaoHoaDonCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"/>


                                            <!-- IN HÓA ĐƠN -->
                                            <Button Content="IN BILL"
Height="45"
Margin="5"
FontSize="16"
FontWeight="Bold"
Background="#4CAF50"
Foreground="White"
Command="{Binding InBillCommand}"/>

                                            <!-- THANH TOÁN -->
                                            <Button Content="Thanh toán"
                                    Height="45"
                                    Margin="5"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Command="{Binding ThanhToanCommand}"/>

                                        </UniformGrid>

                                    </StackPanel>

                                </Border>

                            </GroupBox>

                            <!-- KHÁCH HÀNG -->
                            <GroupBox Header="KHÁCH HÀNG"
                              DockPanel.Dock="Top"
                              FontWeight="Bold"
                              Margin="0,0,0,10">
                                <Border Background="White"
                                Padding="10">


                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>

                                        </Grid.RowDefinitions>

                                        <!-- ====================================== -->
                                        <!-- SDT -->
                                        <!-- ====================================== -->

                                        <ComboBox Grid.Row="0"
              Grid.Column="0"
              Height="35"
              Margin="5"
             ItemsSource="{Binding DataContext.DanhSachKhachHang, RelativeSource={RelativeSource AncestorType=UserControl}    }"
              Text="{Binding SoDienThoai,
                         Mode=TwoWay,
                         UpdateSourceTrigger=PropertyChanged}"

              DisplayMemberPath="Sdt"
              IsEditable="True"
              TextSearch.TextPath="Sdt"
              GotFocus="ComboBox_GotFocus">

                                            <ComboBox.ItemTemplate>

                                                <DataTemplate>

                                                    <TextBlock>

                    <Run Text="{Binding Sdt}"/>
                    <Run Text=" - "/>
                    <Run Text="{Binding Tenkh}"/>

                                                    </TextBlock>

                                                </DataTemplate>

                                            </ComboBox.ItemTemplate>

                                        </ComboBox>

                                        <!-- ====================================== -->
                                        <!-- TÊN KH -->
                                        <!-- ====================================== -->

                                        <TextBox Grid.Row="0"
             Grid.Column="1"
             Height="35"
             Margin="5"
            
             Text="{Binding TenKhachHang,UpdateSourceTrigger=PropertyChanged}"
             materialDesign:HintAssist.Hint="Tên khách hàng"/>

                                        <!-- ====================================== -->
                                        <!-- ĐỊA CHỈ -->
                                        <!-- ====================================== -->

                                        <TextBox Grid.Row="1"
             Grid.Column="0"
             Height="35"
             Margin="5"
                                                 Grid.ColumnSpan="2"
             Text="{Binding DiaChiGiao,UpdateSourceTrigger=PropertyChanged}"
             materialDesign:HintAssist.Hint="Địa chỉ giao hàng"/>

                                        <!-- ====================================== -->
                                        <!-- GHI CHÚ -->
                                        <!-- ====================================== -->

                                        <TextBox Grid.Row="2"
             Grid.Column="0"
             Height="35"
             Margin="5"
                                                  Grid.ColumnSpan="2"
             Text="{Binding GhiChu}"
             materialDesign:HintAssist.Hint="Ghi chú"/>

                                    </Grid>

                                </Border>

                            </GroupBox>

                            <!-- GIỎ HÀNG -->
                            <GroupBox Header="GIỎ HÀNG"
                              FontWeight="DemiBold" >

                                <Border Background="White"
                                Padding="5">

                                    <DataGrid ItemsSource="{Binding GioHang}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False">

                                        <DataGrid.Columns>

                                            <DataGridTextColumn Header="Tên hàng"
                                                        Width="*"
                                                        Binding="{Binding TenHang}"/>

                                            <DataGridTextColumn Header="ĐVT"
                                                        Width="70"
                                                        Binding="{Binding Dvt}"/>

                                            <DataGridTemplateColumn Header="SL"
                        Width="140">

                                                <DataGridTemplateColumn.CellTemplate>

                                                    <DataTemplate>

                                                        <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                                                            <!-- GIẢM -->
                                                            <Button Content="-"
                        Width="40"
                        Height="30"
                        Margin="2" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"

                        Command="{Binding DataContext.GiamSoLuongCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"

                        CommandParameter="{Binding}"/>

                                                            <!-- SỐ LƯỢNG -->
                                                            <TextBox Width="30"
                         Height="30"
                         Margin="2"
                         TextAlignment="Center"

                         Text="{Binding SoLuong,StringFormat={}{0:N2},
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"/>

                                                            <!-- TĂNG -->
                                                            <Button Content="+"
                     Width="40"
 Height="30"
 Margin="2" FontWeight="Bold"
Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                    

                        Command="{Binding DataContext.TangSoLuongCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"

                        CommandParameter="{Binding}"/>

                                                        </StackPanel>

                                                    </DataTemplate>

                                                </DataGridTemplateColumn.CellTemplate>

                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Header="Giá" 
                                                        Width="100"
                                                                
                                                        Binding="{Binding DonGia,StringFormat={}{0:N0},
                                                                          Mode=TwoWay,
                                                                          UpdateSourceTrigger=PropertyChanged}">
                                                <DataGridTextColumn.ElementStyle>

                                                    <Style TargetType="TextBlock">

                                                        <Setter Property="TextAlignment"
                                                                            Value="Right"/>

                                                        <Setter Property="HorizontalAlignment"
                                                                            Value="Stretch"/>

                                                        <Setter Property="VerticalAlignment"
                                                                            Value="Center"/>

                                                        <Setter Property="FontWeight"
                                                                        Value="Bold"/>
                                                        <Setter Property="Padding"
                                                                    Value="0,0,10,0"/>
                                                        <Setter Property="Foreground"
        Value="#E53935"/>

                                                    </Style>

                                                </DataGridTextColumn.ElementStyle>

                                            </DataGridTextColumn>




                                            <DataGridTextColumn Header="TT"
                    Width="120"
                    IsReadOnly="True"
                    Binding="{Binding ThanhTien,
                                      StringFormat={}{0:N0}}">

                                                <DataGridTextColumn.ElementStyle>

                                                    <Style TargetType="TextBlock">

                                                        <Setter Property="TextAlignment"
                                                                Value="Right"/>

                                                        <Setter Property="HorizontalAlignment"
                                                                     Value="Stretch"/>

                                                        <Setter Property="VerticalAlignment"
                                                                        Value="Center"/>

                                                        <Setter Property="FontWeight"
                                                                        Value="Bold"/>
                                                        <Setter Property="Foreground"
                                                        Value="#E53935"/>
                                                        <Setter Property="Padding"
                    Value="0,0,10,0"/>


                                                    </Style>

                                                </DataGridTextColumn.ElementStyle>

                                            </DataGridTextColumn>


                                        </DataGrid.Columns>

                                    </DataGrid>

                                </Border>

                            </GroupBox>

                        </DockPanel>

                    </DataTemplate>

                </TabControl.ContentTemplate>

            </TabControl>

        </Grid>

    </Grid>

</UserControl>