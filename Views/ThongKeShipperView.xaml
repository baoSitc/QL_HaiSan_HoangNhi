<UserControl x:Class="QL_HaiSan_HoangNhi.Views.ThongKeShipperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"             
             
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QL_HaiSan_HoangNhi.Views"
             xmlns:vm="clr-namespace:QL_HaiSan_HoangNhi.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext >
        <vm:ThongKeShipperViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>

        <!-- BUTTON PRIMARY -->

        <Style x:Key="PrimaryButtonStyle"
           TargetType="Button">

            <Setter Property="Foreground"
                Value="White"/>

            <Setter Property="Background"
                Value="#1976D2"/>

            <Setter Property="Padding"
                Value="12,6"/>

            <Setter Property="Margin"
                Value="5"/>

            <Setter Property="BorderThickness"
                Value="0"/>

            <Setter Property="FontWeight"
                Value="Bold"/>

            <Setter Property="Cursor"
                Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                     Value="True">

                    <Setter Property="Background"
                        Value="#1565C0"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="120"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- ================================= -->
        <!-- FILTER -->
        <!-- ================================= -->

        <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Margin="10">

            <DatePicker SelectedDate="{Binding TuNgay}"
                    Margin="5"/>

            <DatePicker SelectedDate="{Binding DenNgay}"
                    Margin="5"/>

            <ComboBox Width="200"
                  Margin="5"
                  ItemsSource="{Binding DanhSachShipper}"
                  SelectedItem="{Binding SelectedShipper}"
                  DisplayMemberPath="Tenshipper"/>

            <Button Content="🔍 LỌC"
        Width="100"
        Style="{StaticResource PrimaryButtonStyle}"
        Command="{Binding FillterCommand}"/>

        </StackPanel>

        <!-- ================================= -->
        <!-- KPI -->
        <!-- ================================= -->

        <UniformGrid Grid.Row="1"
                 Columns="5"
                 Margin="5">

            <!-- TỔNG PHẢI NỘP -->

            <Border Background="#E3F2FD"
            CornerRadius="12"
            Margin="5"
            Padding="15">

                <StackPanel>

                    <TextBlock Text="TỔNG PHẢI NỘP"
                       Foreground="#1565C0"
                       FontWeight="Bold"
                       FontSize="14"/>

                    <TextBlock Text="{Binding TongPhaiNop,
                                      StringFormat={}{0:N0}}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#0D47A1"
                       Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

            <!-- ĐÃ NỘP -->

            <Border Background="#E8F5E9"
            CornerRadius="12"
            Margin="5"
            Padding="15">

                <StackPanel>

                    <TextBlock Text="ĐÃ NỘP"
                       Foreground="#2E7D32"
                       FontWeight="Bold"
                       FontSize="14"/>

                    <TextBlock Text="{Binding TongDaNop,
                                      StringFormat={}{0:N0}}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1B5E20"
                       Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

            <!-- CHƯA NỘP -->

            <Border Background="#FFEBEE"
            CornerRadius="12"
            Margin="5"
            Padding="15">

                <StackPanel>

                    <TextBlock Text="CHƯA NỘP"
                       Foreground="#D32F2F"
                       FontWeight="Bold"
                       FontSize="14"/>

                    <TextBlock Text="{Binding TongChuaNop,
                                      StringFormat={}{0:N0}}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#B71C1C"
                       Margin="0,10,0,0"/>

                </StackPanel>

            </Border>
            <!-- TIỀN SHIP -->

            <Border Background="#FFF3E0"
            CornerRadius="12"
            Margin="5"
            Padding="15">

                <StackPanel>

                    <TextBlock Text="TIỀN SHIP"
                       Foreground="#EF6C00"
                       FontWeight="Bold"
                       FontSize="14"/>

                    <TextBlock Text="{Binding TongTienShipper,
                                      StringFormat={}{0:N0}}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#E65100"
                       Margin="0,10,0,0"/>

                </StackPanel>

            </Border>
            <!-- TIỀN GỬI XE -->

            <Border Background="#F3E5F5"
            CornerRadius="12"
            Margin="5"
            Padding="15">

                <StackPanel>

                    <TextBlock Text="TIỀN GỬI XE"
                       Foreground="#7B1FA2"
                       FontWeight="Bold"
                       FontSize="14"/>

                    <TextBlock Text="{Binding TongTienGuiXe,
                                      StringFormat={}{0:N0}}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#4A148C"
                       Margin="0,10,0,0"/>

                </StackPanel>

            </Border>


        </UniformGrid>

        <!-- ================================= -->
        <!-- GRID -->
        <!-- ================================= -->

        <DataGrid Grid.Row="2"
          x:Name="dgHoaDon"
          Margin="10"
          AutoGenerateColumns="False"
          ItemsSource="{Binding DanhSachHoaDon}"
          SelectedItem="{Binding SelectedHoaDon}"

          HeadersVisibility="Column"
          GridLinesVisibility="Horizontal"
          RowBackground="White"
          AlternatingRowBackground="#F5F5F5"
          AlternationCount="2"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          IsReadOnly="True">
            <DataGrid.ColumnHeaderStyle>

                <Style TargetType="DataGridColumnHeader">

                    <Setter Property="Background"
                Value="#1976D2"/>

                    <Setter Property="Foreground"
                Value="White"/>

                    <Setter Property="FontWeight"
                Value="Bold"/>

                    <Setter Property="Height"
                Value="40"/>

                </Style>

            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>

                <Style TargetType="DataGridRow">

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding DaNopTien}"
                         Value="False">

                            <Setter Property="Background"
                        Value="#FFF3E0"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </DataGrid.RowStyle>

            <DataGrid.Columns>

                <DataGridTextColumn Header="Ngày"
                                Binding="{Binding Ngaylap,
                                                  StringFormat=dd/MM/yyyy}"/>

                <DataGridTextColumn Header="Bill"
                                Binding="{Binding SoHDShort}"/>

                <DataGridTextColumn Header="SĐT"
                Binding="{Binding Khachhang.Sdt}"/>
                
                

                <DataGridTemplateColumn Header="Tên - Địa chỉ giao hàng"
                        Width="250">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <StackPanel>

                                <TextBlock Text="{Binding Khachhang.Tenkh}"
                           FontWeight="Bold"/>

                                <TextBlock Text="{Binding Diachigiao}"
                           FontSize="11"
                           Foreground="Gray"
                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>
                
                

                <DataGridTextColumn Header="Shipper"
                                Binding="{Binding Shipper.Tenshipper}"/>

                <DataGridTextColumn Header="Tổng"
                                Binding="{Binding Tongtien,
                                                  StringFormat={}{0:N0}}"/>

                <DataGridTextColumn Header="Phải nộp"
                                Binding="{Binding Conlai,
                                                  StringFormat={}{0:N0}}"/>
                
                <DataGridTextColumn Header="Tiền Ship"
                Binding="{Binding Phiship,
                                  StringFormat={}{0:N0}}"/>
                
                <DataGridTextColumn Header="Tiền gửi xe"
 Binding="{Binding Phiguixe,
                   StringFormat={}{0:N0}}"/>


                <DataGridTemplateColumn Header=""
                        Width="150" >

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <Button Content="NỘP TIỀN"
        Command="{Binding DataContext.NopTienCommand,
                          ElementName=dgHoaDon}">

                                <Button.Style>

                                    <Style TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">

                                        <Setter Property="Visibility"
                    Value="Visible"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding DaNopTien}"
                             Value="true">

                                                <Setter Property="Visibility"
                            Value="Collapsed"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Button.Style>

                            </Button>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</UserControl>
