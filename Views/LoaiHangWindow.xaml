<Window x:Class="QL_HaiSan_HoangNhi.Views.LoaiHangWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QL_HaiSan_HoangNhi.Views"
        xmlns:vm="clr-namespace:QL_HaiSan_HoangNhi.ViewModels"
        mc:Ignorable="d"
        Title="LoaiHangWindow" Height="450" Width="800">
    <Window.DataContext>
        <vm:LoaiHangViewModel/>
    </Window.DataContext>

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">

            <TextBox Width="250"
                     Margin="5"
                     Text="{Binding LoaiHangMoi.Tenloai}"/>

            <Button Content="Thêm"
                    Width="100"
                    Margin="5"
                    Command="{Binding ThemCommand}"/>

            <Button Content="Sửa"
                    Width="100"
                    Margin="5"
                    Command="{Binding SuaCommand}"/>

            <Button Content="Xóa"
                    Width="100"
                    Margin="5"
                    Command="{Binding XoaCommand}"/>

        </StackPanel>

        <DataGrid Grid.Row="1"
                  Margin="5"
                  ItemsSource="{Binding DanhSachLoaiHang}"
                  SelectedItem="{Binding LoaiHangDangChon}"
                  AutoGenerateColumns="False">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"/>

                <DataGridTextColumn Header="Tên loại"
                                    Binding="{Binding Tenloai}"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</Window>
