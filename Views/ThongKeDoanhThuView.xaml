<UserControl x:Class="QL_HaiSan_HoangNhi.Views.ThongKeDoanhThuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:QL_HaiSan_HoangNhi.ViewModels"
            xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             
             
             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
<UserControl.DataContext>
        <vm:ThongKeDoanhThuViewModel/>
    </UserControl.DataContext>

    <Grid Background="#F5F7FA">

        <Grid.RowDefinitions>

            <!-- FILTER -->
            <RowDefinition Height="Auto"/>

            <!-- KPI -->
            <RowDefinition Height="140"/>

            <!-- CHART -->
            <RowDefinition Height="300"/>

            <!-- GRID -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- ================================= -->
        <!-- FILTER -->
        <!-- ================================= -->

        <Border Background="White"
                Margin="10"
                Padding="10"
                CornerRadius="10">

            <StackPanel Orientation="Horizontal">

                <DatePicker SelectedDate="{Binding TuNgay}"
                            Margin="5"/>

                <DatePicker SelectedDate="{Binding DenNgay}"
                            Margin="5"/>

                <TextBox Width="250"
                         Height="35"
                         Margin="5"
                         VerticalContentAlignment="Center"
                         Text="{Binding TuKhoa}"/>

                <Button Content="🔍 LỌC"
                        Width="120"
                        Margin="5"
                        Command="{Binding LocCommand}"/>

            </StackPanel>

        </Border>

        <!-- ================================= -->
        <!-- KPI -->
        <!-- ================================= -->

        <UniformGrid Grid.Row="1"
                     Columns="5"
                     Margin="10">

            <!-- DOANH THU -->

            <Border Background="#E3F2FD"
                    CornerRadius="12"
                    Margin="5"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="DOANH THU"
                               Foreground="#1565C0"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding TongDoanhThu,
                                              StringFormat={}{0:N0}}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#0D47A1"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

            <!-- TIỀN MẶT -->

            <Border Background="#E8F5E9"
                    CornerRadius="12"
                    Margin="5"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="TIỀN MẶT"
                               Foreground="#2E7D32"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding TongTienMat,
                                              StringFormat={}{0:N0}}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#1B5E20"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

            <!-- CHUYỂN KHOẢN -->

            <Border Background="#E1F5FE"
                    CornerRadius="12"
                    Margin="5"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="CHUYỂN KHOẢN"
                               Foreground="#0277BD"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding TongChuyenKhoan,
                                              StringFormat={}{0:N0}}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#01579B"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

            <!-- CÔNG NỢ -->

            <Border Background="#FFEBEE"
                    CornerRadius="12"
                    Margin="5"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="CÔNG NỢ"
                               Foreground="#D32F2F"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding TongCongNo,
                                              StringFormat={}{0:N0}}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#B71C1C"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

            <!-- HÓA ĐƠN -->

            <Border Background="#F3E5F5"
                    CornerRadius="12"
                    Margin="5"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="HÓA ĐƠN"
                               Foreground="#7B1FA2"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding TongHoaDon}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#4A148C"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

        </UniformGrid>

        <!-- ================================= -->
        <!-- CHART -->
        <!-- ================================= -->

        <Grid Grid.Row="2"
              Margin="10">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2*"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <!-- DOANH THU -->

            <Border Background="White"
                    CornerRadius="12"
                    Padding="15"
                    Margin="5">

                <Grid>

                    <TextBlock Text="DOANH THU THEO NGÀY"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <lvc:CartesianChart Series="{Binding SeriesDoanhThu}"
                                        XAxes="{Binding XAxes}"/>

                </Grid>

            </Border>

            <!-- PIE -->

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="15"
                    Margin="5">

                <Grid>

                    <TextBlock Text="THANH TOÁN"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <lvc:PieChart Series="{Binding SeriesThanhToan}"/>

                </Grid>

            </Border>

        </Grid>

        <!-- ================================= -->
        <!-- GRID -->
        <!-- ================================= -->

        <Grid Grid.Row="3"
              Margin="10">

            <Grid.RowDefinitions>

                <RowDefinition Height="*"/>

                <RowDefinition Height="40"/>

            </Grid.RowDefinitions>

            <DataGrid ItemsSource="{Binding DanhSachHoaDon}"
                      AutoGenerateColumns="False"

                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"

                      RowBackground="White"
                      AlternatingRowBackground="#F5F5F5"
                      AlternationCount="2"

                      CanUserAddRows="False"
                      IsReadOnly="True">

                <!-- ROW STYLE -->

                <DataGrid.RowStyle>

                    <Style TargetType="DataGridRow">

                        <Style.Triggers>

                            <!-- BILL NỢ -->

                            <DataTrigger Binding="{Binding TrangThaiThanhToan}"
                                         Value="CONNO">

                                <Setter Property="Background"
                                        Value="#FFF3E0"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </DataGrid.RowStyle>

                <!-- HEADER -->

                <DataGrid.ColumnHeaderStyle>

                    <Style TargetType="DataGridColumnHeader">

                        <Setter Property="Background"
                                Value="#1976D2"/>

                        <Setter Property="Foreground"
                                Value="White"/>

                        <Setter Property="FontWeight"
                                Value="Bold"/>

                        <Setter Property="Height"
                                Value="40"/>

                    </Style>

                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Ngày"
                                        Width="150"
                                        Binding="{Binding Ngaylap,
                                                          StringFormat=dd/MM/yyyy HH:mm}"/>

                    <DataGridTextColumn Header="Bill"
                                        Width="100"
                                        Binding="{Binding SoHDShort}"/>

                    <DataGridTextColumn Header="Khách hàng"
                                        Width="200"
                                        Binding="{Binding Khachhang.Tenkh}"/>

                    <DataGridTextColumn Header="SĐT"
                                        Width="120"
                                        Binding="{Binding Khachhang.Sdt}"/>

                    <DataGridTextColumn Header="Thanh toán"
                                        Width="120"
                                        Binding="{Binding HinhthucThanhtoan}"/>

                    <DataGridTextColumn Header="Tổng tiền"
                                        Width="150"
                                        Binding="{Binding Tongtien,
                                                          StringFormat={}{0:N0}}"/>

                    <DataGridTextColumn Header="Còn lại"
                                        Width="150"
                                        Binding="{Binding Conlai,
                                                          StringFormat={}{0:N0}}"/>

                </DataGrid.Columns>

            </DataGrid>

            <!-- FOOTER -->

            <Border Grid.Row="1"
                    Background="#ECEFF1"
                    Padding="10">

                <DockPanel>

                    <TextBlock Text="TỔNG DOANH THU:"
                               FontWeight="Bold"
                               FontSize="16"
                               DockPanel.Dock="Left"/>

                    <TextBlock Text="{Binding TongGrid,
                                              StringFormat={}{0:N0}}"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="#1976D2"
                               HorizontalAlignment="Right"/>

                </DockPanel>

            </Border>

        </Grid>

    </Grid>



</UserControl>
